# Database (SQLite via Prisma)
DATABASE_URL="file:./dev.db"

# GitLab Integration Credentials
# Get your GitLab Personal Access Token: https://gitlab.com/-/user_settings/personal_access_tokens
GITLAB_ACCESS_TOKEN=glpat-your-token-here

# Your GitLab Project ID (numeric)
GITLAB_PROJECT_ID=12345678

# GitLab API Base URL (change for self-hosted instances)
GITLAB_API_URL=https://gitlab.com/api/v4

# Google Gemini API Key (for AI-powered Boardroom debates)
# Get your API key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key-here
